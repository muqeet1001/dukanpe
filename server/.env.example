PORT=4000
HOST=0.0.0.0
SHOP_NAME=Dukanpe Demo Shop
# Optional offline mode: omit MONGODB_URI to use local SQLite.
# Put real credentials only in server/.env, which is Git-ignored.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/Dukaan
MONGODB_DB=Dukaan
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: use an installed Chrome if Puppeteer's browser download is unavailable.
# CHROME_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Optional: additional exact web origins, separated by commas.
# CORS_ORIGINS=https://your-app.example
